# Task dotenv files may be generated by an earlier task call.
rivet from-sequence
stdout '^sequence$'

-- Taskfile.yml --
version: 42
tasks:
  generate:
    cmds:
      - cmd: echo "RIVET_TEST_GENERATED={{.VALUE}}" > generated.env
  from-sequence:
    cmds:
      - task: generate
        vars: {VALUE: sequence}
      - task: read
  read:
    dotenv: [generated.env]
    cmds:
      - cmd: echo "{{.RIVET_TEST_GENERATED}}"
