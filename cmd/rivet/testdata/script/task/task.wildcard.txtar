# Wildcard tasks, aliases, and exact matches expose their captured values.
rivet wildcard-foo
stdout '^Hello foo$'
rivet foo-wildcard-bar
stdout '^Hello foo bar$'
rivet start-foo
stdout '^Starting foo$'
rivet s-foo
stdout '^Starting foo$'
rivet 'matches-exactly-*'
stdout '^I don.t consume matches: \[\]$'
rivet wildcard-foo-bar
stdout '^Hello foo-bar$'
! rivet no-match

-- Taskfile.yml --
version: 42
tasks:
  wildcard-*:
    cmds:
      - echo "Hello {{index .MATCH 0}}"
  wildcard-*-*:
    cmds:
      - echo "Hello {{index .MATCH 0}}"
  '*-wildcard-*':
    cmds:
      - echo "Hello {{index .MATCH 0}} {{index .MATCH 1}}"
  matches-exactly-*:
    cmds:
      - "echo \"I don't consume matches: {{.MATCH}}\""
  start-*:
    aliases: [s-*]
    vars:
      SERVICE: "{{index .MATCH 0}}"
    cmds:
      - echo "Starting {{.SERVICE}}"
