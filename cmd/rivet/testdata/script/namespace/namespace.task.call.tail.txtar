# Task call tail from task.
rivet
! stdout 'root build'
stdout -count=1 'one build'
stdout -count=1 'two build'

# Task call root from cli.
rivet :build
stdout -count=1 'root build'
! stdout 'one build'
! stdout 'two build'

# Task call tail from cli.
rivet ::build
! stdout 'root build'
stdout -count=1 'one build'
stdout -count=1 'two build'

-- Taskfile.yml --
version: 42
tasks:
  default:
    cmds:
      - task: ::build
  build:
    cmds:
      - cmd: echo root build

-- one/Taskfile.yml --
version: 42
namespace: task:one
tasks:
  build:
    cmds:
      - cmd: echo one build

-- two/Taskfile.yml --
version: 42
namespace: task:one:two
tasks:
  build:
    cmds:
      - cmd: echo two build
