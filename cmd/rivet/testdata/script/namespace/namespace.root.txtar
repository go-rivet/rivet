# A v42 Taskfile in the working directory with no namespace is the DAG root.

rivet --list-all
stdout '\* hello'
stdout '\* world'

rivet hello
stdout 'hello from root namespace'
stdout 'TASKFILE=.*/Taskfile\.yml'
stdout 'USER_WORKING_DIR=.+'
stdout 'ROOT_DIR=.+'
stdout 'ROOT_TASKFILE=.*/Taskfile\.yml'
stdout 'TASK=hello'
stdout 'NAMESPACE='
stdout 'TASKNAME=hello'

-- Taskfile.yml --
version: 42
tasks:
  hello:
    cmds:
      - echo hello from root namespace
      - echo TASKFILE={{.TASKFILE}}
      - echo USER_WORKING_DIR={{.USER_WORKING_DIR}}
      - echo ROOT_DIR={{.ROOT_DIR}}
      - echo ROOT_TASKFILE={{.ROOT_TASKFILE}}
      - echo TASK={{.TASK}}
      - echo NAMESPACE={{.NAMESPACE}}
      - echo TASKNAME={{.TASKNAME}}
  world:
    cmds:
      - echo world
