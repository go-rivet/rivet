# Task-level Lua commands receive task, call, and namespace environment values.
env RIVET_TEST_ROOT=process NS__RIVET_TEST_VALUE=process
rivet start
rivet --status status

-- Taskfile.yml --
version: 42
vars:
  RIVET_TEST_ROOT: global
  RIVET_TEST_REF: "{{.RIVET_TEST_CALL}}-resolved"
tasks:
  start:
    cmds:
      - task: check
        vars:
          RIVET_TEST_CALL: call
  check:
    vars:
      RIVET_TEST_CALL: task
    lua: |
      rivet.cmd('[ "$RIVET_TEST_ROOT" = global ] && [ "$NS__RIVET_TEST_VALUE" = namespace ]')
      rivet.cmd('[ "$RIVET_TEST_REF" = call-resolved ]')
  status:
    vars:
      RIVET_TEST_CALL: status
    lua: |
      rivet.cmd('[ "$RIVET_TEST_ROOT" = global ] && [ "$NS__RIVET_TEST_VALUE" = namespace ]')
      task.status()
---
version: 42
namespace: ns
vars:
  RIVET_TEST_VALUE: namespace
