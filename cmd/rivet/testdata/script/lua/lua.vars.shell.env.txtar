# Templates, Lua and shell commands receive the resolved DAG variables.
env RIVET_TEST_ROOT=process-root RIVET_TEST_NS=process-namespace
rivet ns:check
cmp stdout expect.stdout

-- Taskfile.yml --
version: 42
vars:
  RIVET_TEST_ROOT: global
---
version: 42
namespace: ns
vars:
  RIVET_TEST_NS: namespace
tasks:
  check:
    cmds:
      - cmd: echo "template={{.:RIVET_TEST_ROOT}}/{{.RIVET_TEST_NS}}"
      - cmd: echo "shell=$RIVET_TEST_ROOT/$NS__RIVET_TEST_NS"
      - lua: |
          print("lua=" .. ctx.root.RIVET_TEST_ROOT .. "/" .. ctx.ns.ns.RIVET_TEST_NS)
          rivet.cmd("echo lua-shell=$RIVET_TEST_ROOT/$NS__RIVET_TEST_NS")

-- expect.stdout --
template=global/namespace
shell=global/namespace
lua=global/namespace
lua-shell=global/namespace
