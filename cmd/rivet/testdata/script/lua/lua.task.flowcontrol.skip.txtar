rivet parameter COND=yes
stdout '^before$'
! stdout '^after$'
stderr 'not needed'
rivet parameter COND=no
stdout '^after$'
! stderr 'not needed'
rivet external COND=yes
stdout '^before$'
! stdout '^after$'
stderr 'not needed'
rivet external COND=no
stdout '^after$'
rivet no-message
stdout '^before$'
! stdout '^after$'
cmp stderr empty
rivet no-message-conditional COND=yes
stdout '^before$'
! stdout '^after$'
cmp stderr empty
rivet no-message-conditional COND=no
stdout '^after$'
cmp stderr empty

rivet nested
cmp stdout expect.nested
stderr 'child skipped'

-- empty --
-- expect.nested --
parent before
child before
parent after
parent command
-- Taskfile.yml --
version: 42
tasks:
  parameter:
    cmds:
      - lua: |
          print("before")
          task.skip(ctx.vars.COND == "yes", "not needed")
          print("after")
      - cmd: echo after
  external:
    cmds:
      - lua: |
          print("before")
          if ctx.vars.COND == "yes" then
            task.skip("not needed")
          end
          print("after")
      - cmd: echo after
  no-message:
    cmds:
      - lua: |
          print("before")
          task.skip()
          print("after")
      - cmd: echo after
  no-message-conditional:
    cmds:
      - lua: |
          print("before")
          task.skip(ctx.vars.COND == "yes")
          print("after")
      - cmd: echo after
  nested:
    cmds:
      - lua: |
          print("parent before")
          rivet.task("nested-child", {})
          print("parent after")
      - cmd: echo parent command
  nested-child:
    cmds:
      - lua: |
          print("child before")
          task.skip("child skipped")
          print("child after")
      - cmd: echo child command
