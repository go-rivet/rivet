# Task dependencies and call vars.
rivet
stdout 'dep a'
stdout 'dep b'
stdout 'dep b v1'
stdout 'dep for x'
stdout 'dep for y'

-- Taskfile.yml --
version: 42
tasks:
  default:
    deps:
      - task: a
      - task: b
        vars:
          V: v1
      - task: c
        vars:
          I: x
      - task: c
        vars:
          I: y
  a:
    cmd: echo dep a
  b:
    cmd: echo dep b {{.V}}
  c:
    cmd: echo dep for {{.I}}
