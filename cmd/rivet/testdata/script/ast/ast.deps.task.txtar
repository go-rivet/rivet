# Task dependencies and call vars.
rivet
stdout 'dep a'
stdout 'dep b'
stdout 'dep b v1'
stdout 'dep for x'
stdout 'dep for y'
stdout -count=1 'dep for hello dependency'

-- Taskfile.yml --
version: 42
tasks:
  default:
    vars:
      TEXT: hello world
    deps:
      - task: a
      - task: b
        vars:
          V: v1
      - task: c
        vars:
          I: x
      - task: c
        vars:
          I: y
      - task: c
        vars:
          I: '{{.TEXT | replace "world" "dependency"}}'
  a:
    cmd: echo dep a
  b:
    cmd: echo dep b {{.V}}
  c:
    cmd: echo dep for {{.I}}
