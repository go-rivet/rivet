# cmd at all schema locations
rivet
stdout 'cmd at task cmd'
stdout 'cmd at task cmd map'
stdout 'cmd at task cmds'
stdout 'cmd at task cmds multiline'
stdout 'cmd at defer map'
stdout 'cmd at dep'

-- Taskfile.yml --
version: 42
tasks:
  default:
    cmds:
      - task: at_task_cmd
      - task: at_task_cmd_map
      - task: at_task_cmds
      - task: at_task_cmds_multiline
      - task: at_defer
      - task: at_dep
  at_task_cmd:
    cmd: echo cmd at task cmd
  at_task_cmd_map:
    cmd:
      cmd: echo cmd at task cmd map
  at_task_cmds:
    cmds:
      - cmd: echo cmd at task cmds
  at_task_cmds_multiline:
    cmds:
      - cmd: |
          echo cmd at task cmds multiline
  at_defer:
    cmds:
      - defer:
          cmd: echo cmd at defer map
  at_dep:
    deps:
      - cmd: echo cmd at dep
    cmds:
      - echo after dep
