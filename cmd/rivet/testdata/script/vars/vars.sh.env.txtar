# Resolved shell variables are exported to commands instead of process values.
env ROOT_SH=process NS__NS_SH=process TASK_SH=process CALL_SH=process
rivet start
cmp stdout expect.stdout

# Shell variables receive the process and task dotenv environment. DAG
# variables can be referenced explicitly in the command template.
env RIVET_TEST_PROCESS=process
rivet environment
cmp stdout expect.environment

-- Taskfile.yml --
version: 42
vars:
  ROOT_SH: {sh: "printf root"}
  RIVET_TEST_GLOBAL: global
tasks:
  start:
    cmds:
      - task: check
        vars:
          CALL_SH: {sh: "printf call"}
  check:
    vars:
      TASK_SH: {sh: "printf task"}
    cmds:
      - cmd: 'echo "root=$ROOT_SH namespace=$NS__NS_SH task=$TASK_SH call=$CALL_SH"'
  environment:
    dotenv: [.task.env]
    vars:
      RESULT: {sh: "printf '%s/%s/%s' \"$RIVET_TEST_PROCESS\" \"$RIVET_TEST_DOTENV\" '{{.RIVET_TEST_GLOBAL}}'"}
    cmds:
      - cmd: echo "{{.RESULT}}"
---
version: 42
namespace: ns
vars:
  NS_SH: {sh: "printf namespace"}

-- .task.env --
RIVET_TEST_DOTENV=dotenv
-- expect.stdout --
root=root namespace=namespace task=task call=call
-- expect.environment --
process/dotenv/global
