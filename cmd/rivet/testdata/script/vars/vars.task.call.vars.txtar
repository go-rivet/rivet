
# Test: task vars
rivet tvar
cmp stdout expect.tvar

# Test: task ns vars
rivet ns:tvar
cmp stdout expect.ns_tvar

# Call vars override task vars for commands and dependencies.
rivet default-values
cmp stdout expect.defaults
rivet command-values
cmp stdout expect.command
rivet dependency-values
cmp stdout expect.dependency

# Task-call variables can use template functions on caller variables.
rivet transformed-call
cmp stdout expect.transformed

-- Taskfile.yml --
---
version: 42
vars:
  FOO: g_foo
  BAR: g_bar
tasks:
  tvar:
    vars:
      FOO: t_foo
    cmds:
      - cmd: echo "foo = {{.FOO}}"
      - cmd: echo "bar = {{.BAR}}"
  default-values:
    cmds:
      - task: values
  command-values:
    cmds:
      - task: values
        vars:
          FOO: command
          EMPTY: ""
          FLAG: false
  dependency-values:
    deps:
      - task: values
        vars:
          FOO: dependency
          EMPTY: ""
          FLAG: false
  transformed-call:
    vars:
      TEXT: "hello world"
    cmds:
      - task: print-value
        vars:
          VALUE: '{{.TEXT | replace "world" "rivet"}}'
  print-value:
    cmds:
      - cmd: echo "{{.VALUE}}"
  values:
    vars:
      FOO: default
      DERIVED: "{{.FOO}}-derived"
      EMPTY: default
      FLAG: true
    cmds:
      - cmd: echo "foo={{.FOO}} derived={{.DERIVED}} empty=[{{.EMPTY}}] flag={{.FLAG}}"
      
-- ns/Taskfile.yml --
---
version: 42
namespace: ns
vars:
  FOO: ns_foo
  BAR: ns_bar
tasks:
  tvar:
    vars:
      FOO: ns_t_foo
    cmds:
      - cmd: echo "foo = {{.FOO}}"
      - cmd: echo "bar = {{.BAR}}"
      - cmd: echo "g_foo = {{.:FOO}}"
      - cmd: echo "g_bar = {{.:BAR}}"

-- expect.tvar --
foo = t_foo
bar = g_bar
-- expect.ns_tvar --
foo = ns_t_foo
bar = ns_bar
g_foo = g_foo
g_bar = g_bar
-- expect.defaults --
foo=default derived=default-derived empty=[default] flag=true
-- expect.command --
foo=command derived=command-derived empty=[] flag=false
-- expect.dependency --
foo=dependency derived=dependency-derived empty=[] flag=false
-- expect.transformed --
hello rivet