# Scalar task and root variables are exported to shell commands as strings.
rivet check
cmp stdout expect.stdout

-- Taskfile.yml --
version: 42
vars:
  RIVET_TEST_NUMBER: 1
  RIVET_TEST_BOOLEAN: false
tasks:
  check:
    vars:
      RIVET_TEST_BOOLEAN: true
      RIVET_TEST_DECIMAL: 1.1
      RIVET_TEST_TEXT: "hello world"
    cmds:
      - cmd: 'echo "number=$RIVET_TEST_NUMBER boolean=$RIVET_TEST_BOOLEAN decimal=$RIVET_TEST_DECIMAL text=$RIVET_TEST_TEXT"'
-- expect.stdout --
number=1 boolean=true decimal=1.1 text=hello world
