# Unresolved DAG vars are warned about and omitted, even over process values.
env DYNAMIC=process BROKEN=process NS__DYNAMIC=process NS__BROKEN=process TASK_DYNAMIC=process
rivet check
cmp stdout expect.stdout
stderr 'shell variable ":DYNAMIC" omitted: sh variables are not supported'
stderr 'shell variable ":BROKEN" omitted: unable to resolve value'
stderr 'shell variable "ns:DYNAMIC" omitted: sh variables are not supported'
stderr 'shell variable "ns:BROKEN" omitted: unable to resolve value'
stderr 'shell variable "TASK_DYNAMIC" omitted: sh variables are not supported'
! exists ran-sh

-- Taskfile.yml --
version: 42
vars:
  DYNAMIC: {sh: "echo ran > ran-sh"}
  BROKEN: "{{.RIVET_TEST_MISSING}}"
tasks:
  check:
    vars:
      TASK_DYNAMIC: {sh: "echo ran > ran-sh"}
    cmds:
      - cmd: echo "root=${DYNAMIC-unset}/${BROKEN-unset} ns=${NS__DYNAMIC-unset}/${NS__BROKEN-unset} task=${TASK_DYNAMIC-unset}"
---
version: 42
namespace: ns
vars:
  DYNAMIC: {sh: "echo ran > ran-sh"}
  BROKEN: "{{.RIVET_TEST_MISSING}}"

-- expect.stdout --
root=unset/unset ns=unset/unset task=unset
