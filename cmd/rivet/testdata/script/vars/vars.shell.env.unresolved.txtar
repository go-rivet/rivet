# Unresolved DAG vars are warned about and omitted, even over process values.
env BROKEN=process NS__BROKEN=process
rivet check
cmp stdout expect.stdout
stderr 'shell variable ":BROKEN" omitted: unable to resolve value'
stderr 'shell variable "ns:BROKEN" omitted: unable to resolve value'

-- Taskfile.yml --
version: 42
vars:
  BROKEN: "{{.RIVET_TEST_MISSING}}"
tasks:
  check:
    cmds:
      - cmd: echo "root=${BROKEN-unset} ns=${NS__BROKEN-unset}"
---
version: 42
namespace: ns
vars:
  BROKEN: "{{.RIVET_TEST_MISSING}}"

-- expect.stdout --
root=unset ns=unset
