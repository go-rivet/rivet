# DAG vars are exported for dependencies and commands.
env RIVET_TEST_ROOT=process RIVET_TEST_VALUE=process NS__RIVET_TEST_VALUE=process
rivet start
cmp stdout expect.stdout

-- Taskfile.yml --
version: 42
vars:
  RIVET_TEST_ROOT: global
  RIVET_TEST_REF: "{{.RIVET_TEST_CALL}}-resolved"
  NS__RIVET_TEST_VALUE: global-collision
tasks:
  start:
    vars:
      RIVET_TEST_CALL: start
    cmds:
      - task: check
        vars:
          RIVET_TEST_CALL: call
          NS__RIVET_TEST_VALUE: call-collision
  check:
    dotenv: [.task.env]
    vars:
      RIVET_TEST_CALL: task
    deps:
      - cmd: '[ "$RIVET_TEST_ROOT" = global ] && [ "$NS__RIVET_TEST_VALUE" = namespace ]'
      - cmd: '[ "$RIVET_TEST_REF" = call-resolved ]'
      - cmd: echo "dep=$RIVET_TEST_ROOT/$NS__RIVET_TEST_VALUE"
    cmds:
      - cmd: echo "cmd=$RIVET_TEST_ROOT/$RIVET_TEST_REF/$NS__RIVET_TEST_VALUE/$RIVET_TEST_VALUE"
      - cmd: echo "nested=$NS__CHILD__VALUE invalid=$NS_A__X_Y leading=$_NS__VALUE"
---
version: 42
namespace: ns
vars:
  RIVET_TEST_VALUE: namespace
---
version: 42
namespace: ns:child
vars:
  VALUE: nested
---
version: 42
namespace: ns-a
vars:
  X-Y: earlier
---
version: 42
namespace: ns_a
vars:
  X-Y: middle
  X_Y: later
---
version: 42
namespace: 9ns
vars:
  VALUE: leading

-- .task.env --
RIVET_TEST_ROOT=dotenv

-- expect.stdout --
dep=global/namespace
cmd=global/call-resolved/namespace/process
nested=nested invalid=later leading=leading
