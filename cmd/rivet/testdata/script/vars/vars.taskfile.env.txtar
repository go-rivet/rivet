
# Test: taskfile env 
env FOO=foo BAR=bar
rivet env
cmp stdout expect.env

# Test: taskfile env override
rivet ns:override
cmp stdout expect.override

-- Taskfile.yml --
---
version: 42
tasks:
  env:
    cmds:
      - cmd: echo "foo = {{.FOO}}"
      - cmd: echo "bar = {{.BAR}}"
      
-- ns/Taskfile.yml --
---
version: 42
namespace: ns
vars:
  g_foo: "{{.FOO}}"
  FOO: g_foo
  g_bar: "{{.BAR}}"
tasks:
  override:
    cmds:
      - cmd: echo "foo = {{.FOO}}"
      - cmd: echo "bar = {{.BAR}}"
      - cmd: echo "g_foo = {{.g_foo}}"
      - cmd: echo "g_bar = {{.g_bar}}"
     
-- expect.env --
foo = foo
bar = bar
-- expect.override --
foo = g_foo
bar = bar
g_foo = g_foo
g_bar = bar