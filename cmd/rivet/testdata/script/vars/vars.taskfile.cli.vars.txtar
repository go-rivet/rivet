
# Test: taskfile cli vars 
rivet cli FOO=c_foo
cmp stdout expect.cli

# Test: taskfile cli override
rivet ns:override FOO=c_foo
cmp stdout expect.override

# Task vars override root and CLI values; rooted lookups retain the CLI value.
rivet task-override
cmp stdout expect.task-default
rivet task-override FOO=c_foo
cmp stdout expect.task-cli

-- Taskfile.yml --
---
version: 42
vars:
  FOO: g_foo
  BAR: g_bar
tasks:
  cli:
    cmds:
      - cmd: echo "foo = {{.FOO}}"
      - cmd: echo "bar = {{.BAR}}"
  task-override:
    vars:
      FOO: t_foo
    cmds:
      - cmd: echo "task = {{.FOO}}"
      - cmd: echo "root = {{.:FOO}}"
      
-- ns/Taskfile.yml --
---
version: 42
namespace: ns
vars:
  FOO: ns_foo
  BAR: ns_bar
tasks:
  override:
    cmds:
      - cmd: echo "foo = {{.FOO}}"
      - cmd: echo "bar = {{.BAR}}"
      - cmd: echo "g_foo = {{.:FOO}}"
      - cmd: echo "g_bar = {{.:BAR}}"
     
-- expect.cli --
foo = c_foo
bar = g_bar
-- expect.override --
foo = ns_foo
bar = ns_bar
g_foo = c_foo
g_bar = g_bar
-- expect.task-default --
task = t_foo
root = g_foo
-- expect.task-cli --
task = t_foo
root = c_foo